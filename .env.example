# ZIPORA configuration. Copy to .env for local development; set the same names in Vercel → Project → Settings → Environment Variables.
# NEVER prefix any of these with VITE_ (that would put them in the browser bundle). See README → "Environment variables".

# ── Required ─────────────────────────────────────────────────────────────
# GitHub OAuth App (github.com/settings/developers → OAuth Apps → New).
# "Authorization callback URL" must be exactly:  <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public origin of the deployed app, no path and no trailing slash. https is required (http://localhost:5173 is allowed for dev).
APP_URL=https://your-project.vercel.app

# Encrypts session cookies (AES-256-GCM). At least 32 characters, random.
# Generate with a password manager's generator (works on a phone) or:  openssl rand -base64 48
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────
# Previous SESSION_SECRET while rotating; remove after SESSION_TTL_SECONDS so old sessions stay valid until they expire.
SESSION_SECRET_PREVIOUS=
# OAuth scopes. Default "repo" (required to write to private repositories); "public_repo" limits ZIPORA to public repositories.
# For a GitHub App (fine-grained permissions) use "none".
GITHUB_OAUTH_SCOPE=repo
# Absolute session lifetime in seconds (300–2592000). Default 604800 (7 days).
SESSION_TTL_SECONDS=604800
# Largest request body the GitHub proxy accepts. Default 4500000 (Vercel's serverless request limit).
PROXY_MAX_BODY_BYTES=4500000
